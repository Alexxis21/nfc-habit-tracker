{
  "expo": {
    "name": "HabitApp",
    "slug": "habitapp",
    "version": "1.0.0",
    "scheme": "habitapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.habitapp.mobile",
      "infoPlist": {
        "NFCReaderUsageDescription": "Aplikacja używa NFC do zbliżeniowego odczytu i zapisu naklejek nawyków.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.habitapp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "react-native-nfc-manager",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "9255e275-5af6-4f73-86c7-95ab17d26476"
      }
    }
  }
}
